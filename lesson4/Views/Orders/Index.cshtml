<h1>Search this:</h1>

<p>
	get /api/orders - повертає список всіх замовлень
</p>
<p>
	get /api/orders/{id} - повертає замовлення за id
</p>
<p>
	get /api/orders/search?title={title} - повертає замовлення за назвою
</p>

<h1>Create Order</h1>

<form asp-controller="Orders" asp-action="Create" method="post">

    <div>
        <label>Title:</label>
        <input name="Title" />
    </div>

    <div>
        <label>Description:</label>
        <input name="Description" />
    </div>

    <div>
        <label>Price:</label>
        <input name="Price" />
    </div>

    <div>
        <label>Quantity:</label>
        <input name="Quantity" />
    </div>

    <button type="submit">Create Order</button>

</form>
