
<h1>Registration</h1>
<form asp-controller="User" asp-action="Create" method="post">

	<input type="text" placeholder="Enter your name" name="name" />

	<input type="text" placeholder="Enter your email" name="email" />

	<input type="text" placeholder="Enter your phone number - 0xx-xxx-xx-xx" name="phoneNumber" />

	<input type="number" placeholder="Enter your age" name="age" />

	<input type="text" placeholder="Enter your password" name="Password" />

	<input type="text" placeholder="Confirm your password" name="ConfirmPassword" />

	<input type="text" placeholder="Enter your line" name="Line" />

	<button type="submit">Register</button>

</form>